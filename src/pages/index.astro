---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { fotoDoServico } from '../data/fotos';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { cidades, cidadesPorRegiao, cidadePath } from '../data/cidades';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'O atendimento é 24 horas mesmo?',
    a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo fins de semana e feriados, em Campinas e nas cidades da região.',
  },
  {
    q: 'Quais cidades vocês atendem?',
    a: `Atendemos ${cidades.length} cidades: ${cidades.map((c) => c.nome).join(', ')}.`,
  },
  {
    q: 'Vocês desentopem sem quebrar o piso?',
    a: 'Na grande maioria dos casos, sim. Usamos máquinas que alcançam a obstrução por dentro da tubulação. Só indicamos abertura quando o cano está quebrado, e sempre com o seu aceite antes.',
  },
  {
    q: 'Vocês fazem limpeza de fossa?',
    a: 'Sim. Fazemos esgotamento de fossa séptica, fossa negra, sumidouro e caixa de gordura com caminhão limpa fossa, em casas, chácaras, sítios, condomínios e empresas.',
  },
  {
    q: 'Como chamo a desentupidora?',
    a: 'É só chamar no WhatsApp ou ligar. Conte o que está acontecendo e em qual cidade você está. Se puder, mande uma foto ou um vídeo do problema.',
  },
];

const fotoHero = fotoDoServico('desentupimento-de-ralo');
const fotoSobre = fotoDoServico('limpa-fossa') ?? fotoDoServico('desentupimento-de-vaso-sanitario');

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title="Desentupidora 24h em Campinas e Região | Universo 24hrs"
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class:list={['hero', 'hero-home', { 'has-photo': fotoHero }]}>
    {
      fotoHero && (
        <Image
          class="hero-bg"
          src={fotoHero.src}
          alt=""
          widths={[480, 800, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container hero-center">
      <span class="eyebrow">Desentupidora e limpa fossa · Plantão 24h</span>
      <h1>Desentupidora 24 horas: <em>vaso, pia, ralo, esgoto e fossa</em></h1>
      <p class="hero-lead">Entupiu ou a fossa encheu? Atendemos a qualquer hora, todos os dias, em {cidades.length} cidades.</p>
      <CtaButtons />
      <ul class="hero-badges">
        <li><Icon name="clock" size={22} /> <span>Atendimento 24h</span></li>
        <li><Icon name="calendar" size={22} /> <span>Fins de semana e feriados</span></li>
        <li><Icon name="map" size={22} /> <span>{cidades.length} cidades</span></li>
      </ul>
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Dia e noite</span></div></div>
      <div class="trust-item"><Icon name="calendar" size={34} /><div><strong>7 dias</strong><span>Inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="truck" size={34} /><div><strong>Limpa fossa</strong><span>Caminhão a vácuo</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>{cidades.length} cidades</strong><span>Campinas e região</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Desentupimento e limpa fossa</h2>
        <p>Do vaso sanitário entupido à fossa cheia: resolvemos em casas, apartamentos, condomínios, chácaras, comércios e empresas.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao cano desentupido</h2>
        <p>Sem enrolação: você chama, a gente vai e resolve.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que entupiu e em qual cidade você está. Se puder, mande uma foto ou um vídeo.</p>
        </div>
        <div class="step-card">
          <h3>Vamos até você</h3>
          <p>Um desentupidor sai com o equipamento certo para o seu caso, a qualquer hora do dia ou da noite.</p>
        </div>
        <div class="step-card">
          <h3>Problema resolvido</h3>
          <p>Desentupimos, testamos o escoamento na sua frente e deixamos o local limpo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={['container', 'about-grid', { 'no-photo': !fotoSobre }]}>
      {
        fotoSobre ? (
          <div class="about-photo">
            <Image src={fotoSobre.src} alt={fotoSobre.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        ) : (
          <div class="about-art" aria-hidden="true">
            <Icon name="truck" size={120} />
            <p>Desentupidora<br /><strong>e limpa fossa</strong></p>
          </div>
        )
      }
      <div>
        <div class="section-head">
          <span class="eyebrow">Por que a Universo 24hrs</span>
          <h2>Desentupidora de confiança, a qualquer hora</h2>
          <p>Equipe preparada para resolver desde um ralo entupido até o esgotamento completo de uma fossa.</p>
        </div>
        <div class="features">
          <div class="feature">
            <Icon name="clock" size={30} />
            <div><h3>Plantão 24 horas</h3><p>Entupimento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
          </div>
          <div class="feature">
            <Icon name="drain" size={30} />
            <div><h3>Sem quebra-quebra</h3><p>Máquinas de cabo rotativo e hidrojateamento alcançam a obstrução por dentro do cano, sem quebrar piso sempre que possível.</p></div>
          </div>
          <div class="feature">
            <Icon name="truck" size={30} />
            <div><h3>Limpa fossa</h3><p>Esgotamento de fossa séptica, fossa negra, sumidouro e caixa de gordura com caminhão a vácuo.</p></div>
          </div>
          <div class="feature">
            <Icon name="map" size={30} />
            <div><h3>{cidades.length} cidades atendidas</h3><p>De Campinas a Mococa, passando por Americana, Indaiatuba, Mogi Guaçu, Serra Negra e muito mais.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />


  <section class="section section-soft" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cidades atendidas</span>
        <h2>Desentupidora perto de você</h2>
        <p>Atendemos {cidades.length} cidades da Região de Campinas, do Circuito das Águas e da Mogiana.</p>
      </div>
      <div class="zones">
        {
          cidadesPorRegiao().map((g) => (
            <div class="zone">
              <h3>{g.regiao}</h3>
              <ul>
                {g.cidades.map((c) => (
                  <li>
                    <a href={cidadePath(c)}>
                      <Icon name="pin" size={16} /> {c.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Dicas</span>
            <h2>Dicas contra entupimento</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Precisa de uma desentupidora agora?" />
</Base>
