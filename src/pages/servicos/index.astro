---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { servicos } from '../../data/servicos';
import { cidades } from '../../data/cidades';
import { breadcrumbSchema } from '../../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
];
---

<Base
  title="Serviços de Desentupidora e Limpa Fossa 24h | Universo 24hrs"
  description="Desentupimento de vaso sanitário, ralo, pia, cano e esgoto, e limpa fossa 24 horas em Campinas e região. Atendemos 27 cidades, todos os dias."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Serviços</span>
      <h1>Serviços de desentupidora e limpa fossa</h1>
      <p class="hero-lead">Desentupimento e esgotamento de fossa 24 horas, todos os dias, em {cidades.length} cidades de Campinas e região.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
