---
// Logo provisório em SVG (troque por src/assets/logo.png quando o cliente mandar o logo oficial)
interface Props {
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---

<span class:list={['logo', `logo-${variant}`]}>
  <svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true">
    <defs>
      <linearGradient id={`lg-${variant}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffe066" />
        <stop offset="1" stop-color="#ffb800" />
      </linearGradient>
    </defs>
    <circle cx="24" cy="24" r="17" fill={`url(#lg-${variant})`} />
    <ellipse cx="24" cy="24" rx="23" ry="8" fill="none" stroke="#c4b5fd" stroke-width="2.4" transform="rotate(-20 24 24)" />
    <path d="M24 13.5c0 0-6.5 7.3-6.5 11.6a6.5 6.5 0 0 0 13 0c0-4.3-6.5-11.6-6.5-11.6z" fill="#1a0b3b" />
  </svg>
  <span class="logo-text">
    <strong>Universo <em>24hrs</em></strong>
    <small>Desentupidora e limpa fossa</small>
  </span>
</span>
